scalar Long

type DepartmentDTO {
    id: ID
    deptName: String
    active: Boolean
}

input DepartmentInputDTO {
    id: ID
    deptName: String
    active: Boolean
    createdBy: Long
    updatedBy: Long
}

type Query {
    getAllDepartments: [DepartmentDTO]
    getDepartmentById(id: ID!): DepartmentDTO
}

type Mutation {
  saveDepartment(input: DepartmentInputDTO!): DepartmentDTO
  updateDepartment(id: ID!, input: DepartmentInputDTO!): DepartmentDTO
  deleteDepartment(id: ID!): Boolean
}
